---
import { useTranslations } from "../../utils/i18n";
import { Sparkles, CheckCircle2 } from "lucide-react";
import { Image } from "astro:assets";
import KaizenLogo from "../../assets/img/K.png";
import SeiriLogo from "../../assets/img/seiri-logo.png";
import BaycoBlack from "../../assets/img/bayco-logo-black.png";
import BaycoWhite from "../../assets/img/bayco-logo-white.png";

const { lang } = Astro.props;
const currentLang = (lang as "es" | "en") || "es";
const t = useTranslations(currentLang);

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA";

const tSending = t("booking.sending");
const tSuccess = t("booking.success");
const tError = t("booking.error");
const tCaptchaRequired = t("booking.captcha.required");
const tSubmit = t("booking.form.submit");
---

<section
    class="relative pt-32 pb-24 px-6 min-h-screen flex items-center justify-center bg-muted/5"
>
    <div class="absolute inset-0 -z-10 overflow-hidden">
        <div
            class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[100px] transform translate-x-1/2 -translate-y-1/2"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue/5 rounded-full blur-[100px] transform -translate-x-1/2 translate-y-1/2"
        >
        </div>
    </div>

    <div class="w-full max-w-5xl mx-auto grid lg:grid-cols-2 gap-16">
        <div class="space-y-8 animate-fade-right">
            <div>
                <span
                    class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary font-bold tracking-widest uppercase text-xs mb-6 border border-primary/20"
                >
                    {t("nav.demo")}
                </span>
                <h1 class="text-4xl md:text-5xl font-bold mb-6 text-foreground">
                    {t("booking.title")}
                </h1>
                <p class="text-xl text-muted leading-relaxed">
                    {t("booking.subtitle")}
                </p>
            </div>

            <div
                class="p-6 rounded-2xl bg-gradient-to-br from-purple/10 to-blue/10 border border-purple/20 flex gap-4"
            >
                <div
                    class="w-10 h-10 rounded-full bg-white dark:bg-gray-800 flex items-center justify-center text-purple shadow-sm shrink-0"
                >
                    <Sparkles size={20} />
                </div>
                <div>
                    <p class="font-bold text-foreground mb-1">AI Integrated</p>
                    <p class="text-sm text-muted">{t("booking.ai.note")}</p>
                </div>
            </div>

            <div class="space-y-4">
                <div class="flex items-center gap-3 text-muted">
                    <CheckCircle2 className="text-primary w-5 h-5" />
                    <span>{t("stats.uptime")}</span>
                </div>
                <div class="flex items-center gap-3 text-muted">
                    <CheckCircle2 className="text-primary w-5 h-5" />
                    <span>{t("hero.badge.sys")}</span>
                </div>
            </div>
        </div>

        <div
            class="bg-panel p-8 md:p-10 rounded-3xl shadow-strong border border-border animate-fade-left"
        >
            <form
                id="booking-form"
                class="space-y-6"
                data-lang={currentLang}
                data-t-sending={tSending}
                data-t-success={tSuccess}
                data-t-error={tError}
                data-t-captcha-required={tCaptchaRequired}
                data-t-submit={tSubmit}
            >
                <div id="form-status" class="hidden p-4 rounded-xl text-sm font-bold animate-fade-in text-center" role="alert"></div>

                <input
                    type="text"
                    name="website"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                    style="position:absolute;left:-9999px;opacity:0;pointer-events:none;width:0;height:0;"
                />

                <div class="grid md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-sm font-bold text-foreground ml-1"
                            >{t("booking.form.name")}</label
                        >
                        <input
                            type="text"
                            name="name"
                            required
                            class="w-full px-4 py-3 rounded-xl bg-background border border-border focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none"
                            placeholder="John Doe"
                        />
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-bold text-foreground ml-1"
                            >{t("booking.form.email")}</label
                        >
                        <input
                            type="email"
                            name="email"
                            required
                            class="w-full px-4 py-3 rounded-xl bg-background border border-border focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none"
                            placeholder="john@company.com"
                        />
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-sm font-bold text-foreground ml-1"
                            >{t("booking.form.phone")}</label
                        >
                        <input
                            type="tel"
                            name="phone"
                            required
                            class="w-full px-4 py-3 rounded-xl bg-background border border-border focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none"
                            placeholder="+1 234 567 890"
                        />
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-bold text-foreground ml-1"
                            >{t("booking.form.role")}</label
                        >
                        <input
                            type="text"
                            name="role"
                            class="w-full px-4 py-3 rounded-xl bg-background border border-border focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none"
                            placeholder="CEO, Manager..."
                        />
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-bold text-foreground ml-1"
                        >{t("booking.form.company")}</label
                    >
                    <input
                        type="text"
                        name="company"
                        required
                        class="w-full px-4 py-3 rounded-xl bg-background border border-border focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all outline-none"
                        placeholder="Company Name"
                    />
                </div>

                <div class="space-y-3 pt-2">
                    <label class="text-sm font-bold text-foreground ml-1"
                        >{t("booking.form.product")}</label
                    >
                    <div class="space-y-3">
                        <label
                            class="relative flex items-start gap-4 p-4 rounded-xl border border-border cursor-pointer hover:border-primary/50 hover:bg-primary/5 transition-all group"
                        >
                            <input
                                type="checkbox"
                                name="product"
                                value="kaizen"
                                class="mt-1 w-4 h-4 text-primary border-border focus:ring-primary rounded"
                            />
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-1">
                                    <Image
                                        src={KaizenLogo}
                                        alt="Kaizen"
                                        class="h-5 w-auto object-contain"
                                    />
                                    <span
                                        class="font-bold text-foreground group-hover:text-primary transition-colors"
                                        >{t("booking.product.kaizen")}</span
                                    >
                                </div>
                                <span class="text-xs text-muted"
                                    >{t("booking.product.kaizen.desc")}</span
                                >
                            </div>
                        </label>

                        <label
                            class="relative flex items-start gap-4 p-4 rounded-xl border border-border cursor-pointer hover:border-emerald/50 hover:bg-emerald/5 transition-all group"
                        >
                            <input
                                type="checkbox"
                                name="product"
                                value="seiri"
                                class="mt-1 w-4 h-4 text-emerald border-border focus:ring-emerald rounded"
                            />
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-1">
                                    <Image
                                        src={SeiriLogo}
                                        alt="Seiri"
                                        class="h-5 w-auto object-contain"
                                    />
                                    <span
                                        class="font-bold text-foreground group-hover:text-emerald transition-colors"
                                        >{t("booking.product.seiri")}</span
                                    >
                                </div>
                                <span class="text-xs text-muted"
                                    >{t("booking.product.seiri.desc")}</span
                                >
                            </div>
                        </label>

                        <label
                            class="relative flex items-start gap-4 p-4 rounded-xl border border-border cursor-pointer hover:border-orange-500/50 hover:bg-orange-500/5 transition-all group"
                        >
                            <input
                                type="checkbox"
                                name="product"
                                value="bayco"
                                class="mt-1 w-4 h-4 text-orange-500 border-border focus:ring-orange-500 rounded"
                            />
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-1">
                                    <div
                                        class="h-5 w-auto dark:hidden"
                                        style={{ filter: "brightness(0)" }}
                                    >
                                        <Image
                                            src={BaycoBlack}
                                            alt="BayCo"
                                            class="h-full w-auto object-contain"
                                        />
                                    </div>
                                    <Image
                                        src={BaycoWhite}
                                        alt="BayCo"
                                        class="h-5 w-auto object-contain hidden dark:block"
                                    />
                                    <span
                                        class="font-bold text-foreground group-hover:text-orange-500 transition-colors"
                                        >{t("booking.product.bayco")}</span
                                    >
                                </div>
                                <span class="text-xs text-muted"
                                    >{t("booking.product.bayco.desc")}</span
                                >
                            </div>
                        </label>
                    </div>
                </div>

                <div
                    class="cf-turnstile"
                    data-sitekey={turnstileSiteKey}
                    data-theme="auto"
                    data-language={currentLang}
                ></div>

                <button
                    id="booking-submit-btn"
                    type="submit"
                    class="w-full btn-primary py-4 rounded-xl font-bold text-lg shadow-lg hover:shadow-primary/25 mt-4 flex items-center justify-center gap-2 transition-all disabled:opacity-75 disabled:cursor-not-allowed"
                >
                    <span id="btn-text">{t("booking.form.submit")}</span>
                    <svg id="btn-spinner" class="animate-spin -ml-1 mr-3 h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
    document.addEventListener("astro:page-load", () => {
        const form = document.getElementById("booking-form");
        if (!form || form._bookingReady) return;
        form._bookingReady = true;

        const { tSending, tSuccess, tError, tCaptchaRequired, tSubmit, lang } = form.dataset;
        const errorClass = "p-4 rounded-xl text-sm font-bold animate-fade-in text-center bg-red-500/10 text-red-500 border border-red-500/20";
        const successClass = "p-4 rounded-xl text-sm font-bold animate-fade-in text-center bg-emerald/10 text-emerald border border-emerald/20";

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const btn = document.getElementById("booking-submit-btn");
            const btnText = document.getElementById("btn-text");
            const btnSpinner = document.getElementById("btn-spinner");
            const statusEl = document.getElementById("form-status");

            if (!btn || !statusEl) return;

            if (form.elements["website"]?.value) return;

            const turnstileToken = form.elements["cf-turnstile-response"]?.value;
            if (!turnstileToken) {
                statusEl.textContent = tCaptchaRequired;
                statusEl.className = errorClass;
                statusEl.classList.remove("hidden");
                return;
            }

            btn.disabled = true;
            if (btnText) btnText.textContent = tSending;
            if (btnSpinner) btnSpinner.classList.remove("hidden");
            statusEl.classList.add("hidden");

            try {
                const formData = new FormData(form);
                const response = await fetch("/api/booking", {
                    method: "POST",
                    body: JSON.stringify({
                        name: formData.get("name"),
                        email: formData.get("email"),
                        phone: formData.get("phone"),
                        role: formData.get("role"),
                        company: formData.get("company"),
                        products: formData.getAll("product"),
                        turnstileToken,
                        lang,
                    }),
                    headers: { "Content-Type": "application/json" },
                });

                const result = await response.json();

                if (result.status === "success") {
                    statusEl.textContent = tSuccess;
                    statusEl.className = successClass;
                    statusEl.classList.remove("hidden");
                    form.reset();
                    if (window.turnstile) window.turnstile.reset();
                } else {
                    throw new Error("server_error");
                }
            } catch {
                statusEl.textContent = tError;
                statusEl.className = errorClass;
                statusEl.classList.remove("hidden");
                if (window.turnstile) window.turnstile.reset();
            } finally {
                btn.disabled = false;
                if (btnText) btnText.textContent = tSubmit;
                if (btnSpinner) btnSpinner.classList.add("hidden");
            }
        });
    });
</script>
