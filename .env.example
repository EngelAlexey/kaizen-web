# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Site key (pública — va en el HTML del widget)
# Crea un sitio en: https://dash.cloudflare.com/ → Turnstile
# Para desarrollo local usa la clave de prueba: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=<TU_SITE_KEY>

# Secret key (PRIVADA — solo usada server-side en src/pages/api/booking.ts)
TURNSTILE_SECRET_KEY=<TU_SECRET_KEY>

# ─── Resend (email transaccional) ────────────────────────────────────────────
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dirección que recibirá las solicitudes de demo
RESEND_TO_EMAIL=contacto@kaizenapps.net

# ─── Kaizen AI (widget de burbuja en las páginas-producto) ───────────────────
# Origen de la app de IA que se embebe en el iframe del widget.
# Debe compartir dominio registrable con este sitio (kaizenapps.net) para que la
# cookie de sesión SameSite=Strict viaje al iframe. Además, este origen debe estar
# en la allowlist de `frame-ancestors` del repo Kaizen-AI (lib/config/embed.ts).
# Local: http://localhost:3000
PUBLIC_AI_ORIGIN=https://ai.kaizenapps.net
